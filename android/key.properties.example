# Copy this file to `android/key.properties` and fill in your real values.
# key.properties is gitignored — it holds your release-signing secrets.
#
# Create your upload keystore once (keep upload-keystore.jks somewhere safe and
# BACKED UP — losing it means you can never update the app):
#
#   keytool -genkey -v -keystore upload-keystore.jks -storetype JKS \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Then put the keystore path below (absolute path, or relative to android/app).

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absolute/path/to/upload-keystore.jks
